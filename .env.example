# Copy this file to .env on the EC2 instance. Never commit .env.
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full&sslrootcert=system
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=<your-ollama-cloud-api-key>
OLLAMA_MODEL=<your-remote-chat-model>
OLLAMA_EMBED_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=180
AWS_REGION=ap-southeast-1
AWS_S3_WORKOUT_PLAN_BUCKET=<your-private-bucket-name>
AWS_S3_WORKOUT_PLAN_URL_EXPIRY_SECONDS=900
