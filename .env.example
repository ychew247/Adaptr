# Copy this file to .env on the EC2 instance. Never commit .env.
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma
AWS_REGION=ap-southeast-1
AWS_S3_WORKOUT_PLAN_BUCKET=<your-private-bucket-name>
AWS_S3_WORKOUT_PLAN_URL_EXPIRY_SECONDS=900
