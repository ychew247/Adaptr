# Copy this file to .env on the EC2 instance. Never commit .env.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full&sslrootcert=/certs/root.crt

AWS_REGION=ap-southeast-2
AWS_S3_WORKOUT_PLAN_BUCKET=<your-private-bucket-name>

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_real_api_key
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_TIMEOUT_SECONDS=180
